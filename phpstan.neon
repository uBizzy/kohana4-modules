# Static analysis of the modules of this repository, with the rules of the
# framework. It expects this repository in a directory of the project root
# (any name), and its modules copied into modules/. From the project root:
#
#     vendor/bin/phpstan analyse -c kohana4-modules/phpstan.neon
includes:
	- ../phpstan.neon

parameters:
	# Only these modules are analysed ("!" replaces the list of the
	# framework); the framework itself is read to know its classes
	paths!:
		- ../modules/ub_debug/classes
		- ../modules/ub_storage/classes
		- ../modules/ub_log_reader/classes
		- ../modules/ub_settings/classes
		- ../modules/ub_autoload/classes
		- ../modules/ub_log/classes
		- ../modules/ub_email/classes
		- ../modules/ub_message/classes

	scanDirectories:
		- ../system/classes
		- ../modules

	# The exceptions listed for the framework are for its own files:
	# that they find nothing here is no mistake
	reportUnmatchedIgnoredErrors: false

	# PHPMailer is a library the application brings: it is not here to
	# be read
	ignoreErrors:
		-
			message: '#PHPMailer#'
			path: ../modules/ub_email/classes/UB/Email.php
